# Copy to ~/.config/myslackcli/.env and fill in your own values. Keep it out of
# the checkout: these are full session credentials for your account, and a file
# sitting next to the source is one stray `git add -f` away from being public.
#
# Browser session token (xoxc-...) and "d" cookie (xoxd-...), taken from your
# own logged-in app.slack.com session — see the README for how to grab these
# via DevTools.
SLACK_TOKEN=
SLACK_COOKIE=
