# Copy to .env and fill in your own values. .env is gitignored — never
# commit real tokens/cookies.
#
# Browser session token (xoxc-...) and "d" cookie (xoxd-...), taken from your
# own logged-in app.slack.com session — see parade/README.md ("Messenger POC")
# for how to grab these via DevTools.
SLACK_TOKEN=
SLACK_COOKIE=
